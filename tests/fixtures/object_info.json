{
  "UnetLoaderGGUF": {
    "input": {
      "required": {
        "unet_name": [["flux2-dev-Q3_K_S.gguf", "flux1-dev-Q4_0.gguf"]]
      }
    },
    "output": ["MODEL"],
    "output_name": ["MODEL"],
    "name": "UnetLoaderGGUF"
  },
  "CLIPLoaderGGUF": {
    "input": {
      "required": {
        "clip_name": [["mistral_3_small_flux2_fp4_mixed.safetensors"]],
        "type": [["flux2", "flux", "sdxl"]]
      }
    },
    "output": ["CLIP"],
    "output_name": ["CLIP"],
    "name": "CLIPLoaderGGUF"
  },
  "VAELoader": {
    "input": {
      "required": { "vae_name": [["flux2-vae.safetensors", "ae.safetensors"]] }
    },
    "output": ["VAE"],
    "output_name": ["VAE"],
    "name": "VAELoader"
  },
  "CLIPTextEncode": {
    "input": {
      "required": {
        "text": ["STRING", { "multiline": true }],
        "clip": ["CLIP"]
      }
    },
    "output": ["CONDITIONING"],
    "output_name": ["CONDITIONING"],
    "name": "CLIPTextEncode"
  },
  "ConditioningZeroOut": {
    "input": { "required": { "conditioning": ["CONDITIONING"] } },
    "output": ["CONDITIONING"],
    "output_name": ["CONDITIONING"],
    "name": "ConditioningZeroOut"
  },
  "EmptyFlux2LatentImage": {
    "input": {
      "required": {
        "width": ["INT", { "default": 1024 }],
        "height": ["INT", { "default": 1024 }],
        "batch_size": ["INT", { "default": 1 }]
      }
    },
    "output": ["LATENT"],
    "output_name": ["LATENT"],
    "name": "EmptyFlux2LatentImage"
  },
  "Flux2Scheduler": {
    "input": {
      "required": {
        "steps": ["INT", { "default": 28 }],
        "width": ["INT", { "default": 1024 }],
        "height": ["INT", { "default": 1024 }]
      }
    },
    "output": ["SIGMAS"],
    "output_name": ["SIGMAS"],
    "name": "Flux2Scheduler"
  },
  "KSampler": {
    "input": {
      "required": {
        "seed": ["INT", { "default": 0 }],
        "steps": ["INT", { "default": 20 }],
        "cfg": ["FLOAT", { "default": 8.0 }],
        "sampler_name": [
          ["euler", "euler_ancestral", "dpmpp_2m", "res_multistep"]
        ],
        "scheduler": [["normal", "karras", "simple", "sgm_uniform"]],
        "denoise": ["FLOAT", { "default": 1.0 }],
        "model": ["MODEL"],
        "positive": ["CONDITIONING"],
        "negative": ["CONDITIONING"],
        "latent_image": ["LATENT"]
      }
    },
    "output": ["LATENT"],
    "output_name": ["LATENT"],
    "name": "KSampler"
  },
  "VAEDecode": {
    "input": {
      "required": {
        "samples": ["LATENT"],
        "vae": ["VAE"]
      }
    },
    "output": ["IMAGE"],
    "output_name": ["IMAGE"],
    "name": "VAEDecode"
  },
  "SaveImage": {
    "input": {
      "required": {
        "filename_prefix": ["STRING", { "default": "ComfyUI" }],
        "images": ["IMAGE"]
      }
    },
    "output": [],
    "output_name": [],
    "name": "SaveImage"
  },
  "ControlNetLoader": {
    "input": {
      "required": {
        "control_net_name": [["flux1-dev-controlnet-union-pro.safetensors"]]
      }
    },
    "output": ["CONTROL_NET"],
    "output_name": ["CONTROL_NET"],
    "name": "ControlNetLoader"
  },
  "LoraLoader": {
    "input": {
      "required": {
        "model": ["MODEL"],
        "clip": ["CLIP"],
        "lora_name": [["z_image_turbo/zit-c64.safetensors"]],
        "strength_model": ["FLOAT", { "default": 1.0 }],
        "strength_clip": ["FLOAT", { "default": 1.0 }]
      }
    },
    "output": ["MODEL", "CLIP"],
    "output_name": ["MODEL", "CLIP"],
    "name": "LoraLoader"
  },
  "LoadImage": {
    "input": {
      "required": {
        "image": [["depth_map.png", "sky_mask.png", "subject.png"]]
      }
    },
    "output": ["IMAGE", "MASK"],
    "output_name": ["IMAGE", "MASK"],
    "name": "LoadImage"
  },
  "ControlNetApplyAdvanced": {
    "input": {
      "required": {
        "positive": ["CONDITIONING"],
        "negative": ["CONDITIONING"],
        "control_net": ["CONTROL_NET"],
        "image": ["IMAGE"],
        "strength": ["FLOAT", { "default": 1.0 }],
        "start_percent": ["FLOAT", { "default": 0.0 }],
        "end_percent": ["FLOAT", { "default": 1.0 }]
      },
      "optional": { "vae": ["VAE"] }
    },
    "output": ["CONDITIONING", "CONDITIONING"],
    "output_name": ["positive", "negative"],
    "name": "ControlNetApplyAdvanced"
  }
}
