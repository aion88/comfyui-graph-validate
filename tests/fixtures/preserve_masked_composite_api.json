    "inputs": { "samples": ["43", 0], "mask": ["42", 0] }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["1", 1], "text": "marble pedestal, soft daylight" }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["1", 1], "text": "" }
