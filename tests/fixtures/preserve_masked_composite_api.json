  "45": {
    "class_type": "DifferentialDiffusion",
    "inputs": { "model": ["1", 0] }
  },
  "10": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["9", 0],
      "negative": ["8", 0],
      "control_net": ["2", 0],
      "image": ["6", 0],
      "strength": 0.8,
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "2": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "flux1-dev-controlnet-union-pro.safetensors"
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["45", 0],
      "positive": ["10", 0],
      "negative": ["10", 1],
      "latent_image": ["44", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.8
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["11", 0], "vae": ["1", 2] }
  },
  "46": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["12", 0],
      "source": ["5", 0],
      "mask": ["41", 0],
      "x": 0,
      "y": 0,
      "resize_source": false
